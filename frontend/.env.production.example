# JPPHAF frontend — PRODUCTION template (Phase 13a). Copy to frontend/.env.production (or set on the host) BEFORE `npm run build`:
# NEXT_PUBLIC_* values are baked into the build, and next.config.ts builds the Content-Security-Policy from them.
# Only public values belong here — never a secret.

NEXT_PUBLIC_API_URL=https://api.<your-domain>

# Live chat (Reverb) — same public key as backend REVERB_APP_KEY; host/port/scheme as the browser reaches it
NEXT_PUBLIC_REVERB_APP_KEY=<same as backend REVERB_APP_KEY>
NEXT_PUBLIC_REVERB_HOST=ws.<your-domain>
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https
