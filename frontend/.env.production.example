# JPPHAF frontend — PRODUCTION template for cPanel (Phase 13a + 14a). Copy to frontend/.env.production on your computer
# BEFORE running deploy-package.bat: NEXT_PUBLIC_* values are baked into the build, and next.config.ts builds the
# Content-Security-Policy from them. Only public values belong here — never a secret.
# Site: https://sacomputer.com.bd  |  API: https://api.sacomputer.com.bd

NEXT_PUBLIC_API_URL=https://api.sacomputer.com.bd

# Live chat via Pusher Channels - same key and cluster as backend PUSHER_APP_KEY / PUSHER_APP_CLUSTER (both public).
# Leave both lines out and the chat refreshes by polling instead (every 5 s inside an open chat, 30 s for counts).
NEXT_PUBLIC_PUSHER_APP_KEY=<same as backend PUSHER_APP_KEY>
NEXT_PUBLIC_PUSHER_APP_CLUSTER=<same as backend PUSHER_APP_CLUSTER>
