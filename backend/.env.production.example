# JPPHAF backend — PRODUCTION template for cPanel (Phase 13a + 14a). Copy to backend/.env on the server (~/jpphaf/backend/.env)
# and fill every <placeholder>. Site: https://sacomputer.com.bd  |  API: https://api.sacomputer.com.bd
# Never commit or share the filled file. Real secrets live only in the server's .env.

APP_NAME=JPPHAF
APP_ENV=production
APP_KEY=                                # php artisan key:generate --force (once, on the server)
APP_DEBUG=false                         # must stay false online: true shows error details to visitors
APP_URL=https://api.sacomputer.com.bd
FRONTEND_URL=https://sacomputer.com.bd  # the only origin allowed by CORS (config/cors.php)
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# First Super Admin (used once by SuperAdminSeeder; use a REAL phone and a strong password, then change it after login)
SUPER_ADMIN_NAME="<name>"
SUPER_ADMIN_PHONE=<01XXXXXXXXX>
SUPER_ADMIN_EMAIL=<email>
SUPER_ADMIN_PASSWORD=<strong-password>

DB_CONNECTION=mysql
DB_HOST=<db-host>
DB_PORT=3306
DB_DATABASE=<db-name>
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.sacomputer.com.bd       # shared by the site + API sub-domains
SESSION_SECURE_COOKIE=true              # cookies only over HTTPS
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=sacomputer.com.bd,www.sacomputer.com.bd  # the frontend's domain (no https://)
SANCTUM_TOKEN_EXPIRATION=120

BROADCAST_CONNECTION=pusher             # cPanel: Pusher Channels (no long-running server). Local dev uses reverb.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database               # worked by the cPanel cron job (queue:work --stop-when-empty), see docs/DEPLOYMENT_CPANEL.md
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="<noreply@your-domain>"
MAIL_FROM_NAME="${APP_NAME}"

# Chat — Pusher Channels (free plan). Create an app at https://pusher.com (Channels), pick the cluster nearest to you (e.g. ap2 Mumbai).
# The key and cluster are public (the browser needs them); the secret stays here only.
PUSHER_APP_ID=<from Pusher: App Keys>
PUSHER_APP_KEY=<from Pusher: App Keys>
PUSHER_APP_SECRET=<from Pusher: App Keys>
PUSHER_APP_CLUSTER=<e.g. ap2>
PUSHER_SCHEME=https
PUSHER_PORT=443

# Reverb is for local development only - leave these out online (do not run a Reverb server on cPanel).

# Web Push — generate once with: php artisan webpush:vapid ; keep the same keys forever (changing them drops all subscriptions)
VAPID_PUBLIC_KEY=<generate>
VAPID_PRIVATE_KEY=<generate>
VAPID_SUBJECT=mailto:<admin-email>
