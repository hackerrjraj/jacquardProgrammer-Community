# JPPHAF backend — PRODUCTION template (Phase 13a). Copy to backend/.env on the server and fill every <placeholder>.
# Never commit or share the filled file. Real secrets live only in the server's .env.

APP_NAME=JPPHAF
APP_ENV=production
APP_KEY=                                # php artisan key:generate --force (once, on the server)
APP_DEBUG=false                         # must stay false online: true shows error details to visitors
APP_URL=https://api.<your-domain>
FRONTEND_URL=https://<your-domain>      # the only origin allowed by CORS
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# First Super Admin (used once by SuperAdminSeeder; use a REAL phone and a strong password, then change it after login)
SUPER_ADMIN_NAME="<name>"
SUPER_ADMIN_PHONE=<01XXXXXXXXX>
SUPER_ADMIN_EMAIL=<email>
SUPER_ADMIN_PASSWORD=<strong-password>

DB_CONNECTION=mysql
DB_HOST=<db-host>
DB_PORT=3306
DB_DATABASE=<db-name>
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.<your-domain>           # shared by the site + API sub-domains
SESSION_SECURE_COOKIE=true              # cookies only over HTTPS
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=<your-domain>  # the frontend's domain (no https://)
SANCTUM_TOKEN_EXPIRATION=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database               # needs a running `php artisan queue:work` (see docs/DEPLOYMENT_NOTES.md)
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="<noreply@your-domain>"
MAIL_FROM_NAME="${APP_NAME}"

# Chat — Laravel Reverb. The browser connects to wss://<REVERB_HOST>:<REVERB_PORT> (put it behind HTTPS / a reverse proxy).
REVERB_APP_ID=<generate>
REVERB_APP_KEY=<generate>
REVERB_APP_SECRET=<generate>
REVERB_HOST=ws.<your-domain>
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=<your-domain>    # the site's domain only (no wildcard)

# Web Push — generate once with: php artisan webpush:vapid ; keep the same keys forever (changing them drops all subscriptions)
VAPID_PUBLIC_KEY=<generate>
VAPID_PRIVATE_KEY=<generate>
VAPID_SUBJECT=mailto:<admin-email>
