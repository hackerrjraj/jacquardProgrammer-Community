APP_NAME=JPPHAF
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_PHONE=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=jpphaf
DB_USERNAME=jpphaf
DB_PASSWORD=""

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Login sessions = cookies (Sanctum SPA); logout ends the session. Tokens (none are issued) would expire after this many minutes.
SANCTUM_TOKEN_EXPIRATION=120

# ---- Production (Phase 13, on the real HTTPS domain) — security settings (Phase 12c) ----
# APP_ENV=production
# APP_DEBUG=false                      # never true online: it shows error details to visitors
# APP_URL=https://api.example.org
# FRONTEND_URL=https://example.org     # the only origin allowed by CORS
# SANCTUM_STATEFUL_DOMAINS=example.org # the frontend's domain (no https://)
# SESSION_DOMAIN=.example.org          # shared by the site + API sub-domains
# SESSION_SECURE_COOKIE=true           # cookies only over HTTPS
# SESSION_ENCRYPT=true
# SESSION_SAME_SITE=lax
# LOG_LEVEL=warning

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Chat (Phase 9a) — Laravel Reverb WebSocket on port 8080. Run `php artisan reverb:install` to fill the app id / key / secret.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

# Pusher Channels (Phase 14a, online hosting only). Local development keeps BROADCAST_CONNECTION=reverb.
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=ap2

# Web Push (Phase 10c-1) — generate with: php artisan webpush:vapid (secret; keep the same keys in production)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
